# Copy this file to .env and fill in your API key. NEVER commit .env.

# ─── OPTION A: Groq (free, fast, recommended) ───────────────────────────────
# Get your free key at: https://console.groq.com/keys
LLM_PROVIDER=groq
LLM_MODEL=openai/gpt-oss-120b
GROQ_API_KEY=

# ─── OPTION B: Google Gemini ─────────────────────────────────────────────────
# Get your free key at: https://aistudio.google.com/
# LLM_PROVIDER=google_genai
# LLM_MODEL=gemini-2.5-flash
# GOOGLE_API_KEY=

# ─── OPTION C: OpenAI ────────────────────────────────────────────────────────
# LLM_PROVIDER=openai
# LLM_MODEL=gpt-4o-mini
# OPENAI_API_KEY=

# ─── Weather ─────────────────────────────────────────────────────────────────
# live = real Open-Meteo calls | fixture = read JSON from evals/fixtures/
WEATHER_MODE=live

# Set to 1 to simulate the weather API being down (used by the failure eval)
WEATHER_FORCE_FAIL=0

# Folder the SOP YAML files are loaded from
SOP_DIR=sops

# ─── Fallback LLM (optional) ─────────────────────────────────────────────────
# If set, any 429/500 on the primary automatically retries on this.
# LLM_MODEL_FALLBACK=
# GROQ_API_KEY_FALLBACK=
