# Copy this file to .env and fill in ONE provider's key. NEVER commit .env.

# Which provider to use: google | openai | anthropic
LLM_PROVIDER=google

# Model name for that provider (check the provider docs for current names)
# google:    gemini-2.5-flash
# openai:    gpt-4o-mini
# anthropic: claude-haiku-4-5
LLM_MODEL=gemini-2.5-flash

GOOGLE_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# live = real Open-Meteo calls | fixture = read JSON from evals/fixtures (used by evals)
WEATHER_MODE=live

# Set to 1 to simulate the weather API being down (used by the failure eval)
WEATHER_FORCE_FAIL=0

# Folder the SOP YAML files are loaded from
SOP_DIR=sops

# LLM Fallback (optional)
GOOGLE_API_KEY_FALLBACK=
LLM_MODEL_FALLBACK=
